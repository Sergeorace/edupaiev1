/* Feuille de style pour Edupaie - Design moderne */

QMainWindow {
    background-color: #f8fafc;
}

/* Barre latérale */
QFrame#sidebar {
    background-color: #4f46e5;
    color: white;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    color: #ffffff;
    padding: 14px 16px;
    text-align: left;
    font-size: 14px;
    font-weight: 500;
    border-radius: 8px;
    margin: 2px 8px;
}

QPushButton#navButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
}

QPushButton#navButton:checked {
    background-color: #6366f1;
    font-weight: 600;
    color: #ffffff;
}

/* Titres */
QLabel#title {
    font-size: 24px;
    font-weight: 700;
    color: #1e293b;
}

QLabel#subtitle {
    font-size: 18px;
    font-weight: 600;
    color: #334155;
}

/* Cartes du dashboard */
QFrame#card {
    background-color: #ffffff;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
}

QLabel#cardValue {
    font-size: 28px;
    font-weight: 700;
    color: #1e293b;
}

QLabel#cardLabel {
    font-size: 13px;
    color: #64748b;
    font-weight: 500;
}

/* Tableau des élèves */
QTableView {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    font-size: 13px;
}

QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #f1f5f9;
    font-size: 13px;
}

QTableView::item {
    padding: 12px;
    color: #1e293b;
}

QTableWidget::item {
    padding: 10px;
    color: #1e293b;
}

QTableView::item:selected {
    background-color: #6366f1;
    color: white;
}

QTableWidget::item:selected {
    background-color: #6366f1;
    color: white;
}

QHeaderView::section {
    background-color: #f8fafc;
    color: #475569;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #e2e8f0;
    font-weight: 600;
    font-size: 13px;
}

/* Boutons */
QPushButton {
    background-color: #6366f1;
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #4f46e5;
}

QPushButton:pressed {
    background-color: #4338ca;
}

QPushButton:disabled {
    background-color: #cbd5e1;
    color: #94a3b8;
}

QPushButton#dangerButton {
    background-color: #ef4444;
}

QPushButton#dangerButton:hover {
    background-color: #dc2626;
}

QPushButton#successButton {
    background-color: #10b981;
}

QPushButton#successButton:hover {
    background-color: #059669;
}

/* Champs de formulaire */
QLineEdit, QComboBox, QDateEdit, QSpinBox {
    padding: 10px 12px;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    background-color: white;
    font-size: 13px;
    color: #1e293b;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 2px solid #6366f1;
}

/* Labels de formulaire */
QLabel {
    color: #475569;
    font-size: 13px;
    font-weight: 500;
}

QLabel#required {
    color: #ef4444;
}

QLabel#validationMessage {
    color: #ef4444;
    font-weight: 600;
}

QLabel#balanceBefore, QLabel#balanceAfter {
    padding: 12px;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    color: #1e293b;
}

/* Dialog */
QDialog {
    background-color: #ffffff;
}

/* Statut colors */
QLabel#statutImpaye {
    color: #ef4444;
    font-weight: 600;
    font-size: 13px;
}

QLabel#statutPartiel {
    color: #f59e0b;
    font-weight: 600;
    font-size: 13px;
}

QLabel#statutPaye {
    color: #10b981;
    font-weight: 600;
    font-size: 13px;
}

/* ScrollArea */
QScrollArea {
    border: none;
    background-color: #f8fafc;
}

/* Barre de recherche */
QLineEdit#searchInput {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 10px 12px;
    font-size: 13px;
}

QLineEdit#searchInput:focus {
    border: 2px solid #6366f1;
}
