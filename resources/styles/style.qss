/* Feuille de style pour l'application Gestion Scolarité */

QMainWindow {
    background-color: #f5f5f5;
}

/* Barre latérale */
QFrame#sidebar {
    background-color: #2c3e50;
    color: white;
}

QPushButton#navButton {
    background-color: transparent;
    border: none;
    color: #ecf0f1;
    padding: 12px;
    text-align: left;
    font-size: 14px;
    border-radius: 4px;
}

QPushButton#navButton:hover {
    background-color: #34495e;
}

QPushButton#navButton:checked {
    background-color: #3498db;
    font-weight: bold;
}

/* Titres */
QLabel#title {
    font-size: 24px;
    font-weight: bold;
    color: #2c3e50;
}

QLabel#subtitle {
    font-size: 18px;
    font-weight: bold;
    color: #34495e;
}

/* Cartes du dashboard */
QFrame#card {
    background-color: white;
    border-radius: 8px;
    border: 1px solid #e0e0e0;
}

QLabel#cardValue {
    font-size: 28px;
    font-weight: bold;
    color: #2c3e50;
}

QLabel#cardLabel {
    font-size: 14px;
    color: #7f8c8d;
}

/* Tableau des élèves */
QTableView {
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    gridline-color: #ecf0f1;
}

QTableWidget {
    background-color: white;
    alternate-background-color: #f8fafc;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    gridline-color: #ecf0f1;
}

QTableView::item {
    padding: 8px;
}

QTableWidget::item {
    padding: 6px;
}

QTableView::item:selected {
    background-color: #3498db;
    color: white;
}

QTableWidget::item:selected {
    background-color: #3498db;
    color: white;
}

QHeaderView::section {
    background-color: #ecf0f1;
    color: #2c3e50;
    padding: 8px;
    border: none;
    border-bottom: 2px solid #bdc3c7;
    font-weight: bold;
}

/* Boutons */
QPushButton {
    background-color: #3498db;
    color: white;
    border: none;
    padding: 8px 16px;
    border-radius: 4px;
    font-size: 14px;
}

QPushButton:hover {
    background-color: #2980b9;
}

QPushButton:pressed {
    background-color: #21618c;
}

QPushButton:disabled {
    background-color: #bdc3c7;
    color: #7f8c8d;
}

QPushButton#dangerButton {
    background-color: #e74c3c;
}

QPushButton#dangerButton:hover {
    background-color: #c0392b;
}

QPushButton#successButton {
    background-color: #27ae60;
}

QPushButton#successButton:hover {
    background-color: #229954;
}

/* Champs de formulaire */
QLineEdit, QComboBox, QDateEdit, QSpinBox {
    padding: 8px;
    border: 1px solid #bdc3c7;
    border-radius: 4px;
    background-color: white;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus, QSpinBox:focus {
    border: 2px solid #3498db;
}

/* Labels de formulaire */
QLabel {
    color: #2c3e50;
}

QLabel#required {
    color: #e74c3c;
}

QLabel#validationMessage {
    color: #c0392b;
    font-weight: bold;
}

QLabel#balanceBefore, QLabel#balanceAfter {
    padding: 10px;
    background-color: white;
    border: 1px solid #e0e0e0;
    border-radius: 4px;
    font-weight: bold;
}

/* Dialog */
QDialog {
    background-color: #f5f5f5;
}

/* Statut colors */
QLabel#statutImpaye {
    color: #e74c3c;
    font-weight: bold;
}

QLabel#statutPartiel {
    color: #f39c12;
    font-weight: bold;
}

QLabel#statutPaye {
    color: #27ae60;
    font-weight: bold;
}

/* ScrollArea */
QScrollArea {
    border: none;
    background-color: #f5f5f5;
}
